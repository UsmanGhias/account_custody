<odoo>
    <data>
        <record id="action_custody_payment" model="ir.actions.server">
            <field name="type">ir.actions.server</field>
            <field name="name">Register Payment</field>
            <field name="state">code</field>
            <field name="model_id" ref="model_account_custody"/>
            <field name="code">action = record.open_payment_form()</field>
        </record>

        <record id="custody_view_form" model="ir.ui.view">
            <field name="name">account.custody.form</field>
            <field name="model">account.custody</field>
            <field name="arch" type="xml">
                <form string="Custody">
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_post" string="Register Payment" type="object" invisible="state != 'submit'"
                                class="oe_highlight" groups="cc_account_custody.custody_first_posting"/>
                        <button name="action_wait" type="object" string="Wait Clearance" invisible="state != 'posted'"
                                groups="cc_account_custody.custody_first_posting"/>
                        <button name="%(custody_add_line_wizard_action)d" type="action" invisible="state != 'w_clear'"
                                string="Return Amount" context="{'return_amount': True}"/>
                        <button name="action_last_approve" string="Approval" type="object" invisible="state != 'w_clear'"
                                class="oe_highlight" groups="cc_account_custody.last_approve"/>
                        <button name="action_line_post" type="object" string="Custody Line Post" invisible="state != 'approve'"
                                groups="cc_account_custody.custody_line_second_posting"/>
                        <button name="action_close" type="object" string="Clear" invisible="state != 'post2'"
                                groups="cc_account_custody.custody_line_second_posting"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,submit,posted,w_clear,approve,post2,cleared"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="General">
                                <field name="description" readonly="state in ('posted', 'w_clear', 'approve', 'post2', 'cleared')"/>
                                <field name="amount" readonly="state in ('posted', 'w_clear', 'approve', 'post2', 'cleared')"/>
                                <field name="date" readonly="state in ('posted', 'w_clear', 'approve', 'post2', 'cleared')"/>
                                <field name="employee_id" readonly="state in ('posted', 'w_clear', 'approve', 'post2', 'cleared')"/>
                            </group>

                            <group string="Accounting"
                                   groups="cc_account_custody.custody_first_posting,cc_account_custody.custody_line_second_posting,cc_account_custody.last_approve">
                                <field name="journal_id" readonly="state != 'submit'"/>
                                <field name="account_id" options="{'no_create': True, 'no_open': True}"
                                       context="{'active_test': False}"
                                       domain="[('deprecated', '=', False)]"
                                       readonly="state != 'submit'"/>
                                <field name="pay_date" readonly="state != 'submit'"/>
                                <field name="analytic_account_id" readonly="state != 'submit'"/>
                                <field name="move_id" readonly="1"/>
                                <field name="cus_journal_id" readonly="state in ('post2', 'cleared')"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" context="{'default_custody_id': id}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="custody_view_tree" model="ir.ui.view">
            <field name="name">account.custody.tree</field>
            <field name="model">account.custody</field>
            <field name="arch" type="xml">
                <tree string="Custody">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="amount" sum="Total"/>
                    <field name="balance" sum="Total Balance"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="custody_line_view_form" model="ir.ui.view">
            <field name="name">account.custody.line.form</field>
            <field name="model">account.custody.line</field>
            <field name="arch" type="xml">
                <form string="Custody Line">
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="amount"/>
                                <field name="date"/>
                                <field name="attachment_id" widget="many2many_binary" colspan="2" string="Upload Files"/>
                                <field name="custody_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="account_id" domain="[('deprecated', '=', False)]"
                                       groups="cc_account_custody.custody_line_second_posting"/>
                                <field name="analytic_account_id" groups="cc_account_custody.custody_line_second_posting"/>
                                <field name="move_id" groups="cc_account_custody.custody_line_second_posting" readonly="1"/>
                                <field name="currency_id" groups="cc_account_custody.custody_line_second_posting" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="custody_line_view_tree" model="ir.ui.view">
            <field name="name">account.custody.line.tree</field>
            <field name="model">account.custody.line</field>
            <field name="arch" type="xml">
                <tree string="Custody Line">
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="date"/>
                    <field name="attachment_id" widget="many2many_binary" colspan="2" string="Upload Files"/>
                    <field name="account_id" domain="[('deprecated', '=', False)]"
                           groups="cc_account_custody.custody_line_second_posting"/>
                    <field name="analytic_account_id" groups="cc_account_custody.custody_line_second_posting"/>
                    <field name="move_id" groups="cc_account_custody.custody_line_second_posting"/>
                </tree>
            </field>
        </record>

        <record id="custody_action" model="ir.actions.act_window">
            <field name="name">Custodies</field>
            <field name="res_model">account.custody</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="custody_view_tree"/>
        </record>

        <menuitem id="custody_root_menu" name="Custodies"
                  web_icon="cc_account_custody,static/description/icon.png"/>
        <menuitem id="custody_menu" name="Custodies" action="custody_action" parent="custody_root_menu" sequence="10"/>
    </data>
</odoo>
